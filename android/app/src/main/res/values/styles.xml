<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorControlActivated">@color/native_accent</item>
        <item name="colorControlNormal">@color/native_text_muted</item>
        <item name="android:windowBackground">@color/native_background</item>
        <item name="android:statusBarColor">@color/native_background</item>
        <item name="android:navigationBarColor">@color/native_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="NativeSectionTitle">
        <item name="android:textColor">@color/native_text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="NativeMetaChip">
        <item name="android:background">@drawable/bg_native_meta_chip</item>
        <item name="android:textColor">@color/native_text_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="NativeValueChip" parent="@style/NativeMetaChip">
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="NativeSummaryChip" parent="@style/NativeMetaChip">
        <item name="android:textSize">11sp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="NativeStatusText">
        <item name="android:background">@drawable/bg_native_status_info</item>
        <item name="android:textColor">@color/native_accent</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="NativeSecondaryButton" parent="@style/Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_native_button_secondary</item>
        <item name="android:textColor">@color/native_text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="NativePrimaryButton" parent="@style/NativeSecondaryButton">
        <item name="android:background">@drawable/bg_native_button_primary</item>
        <item name="android:textColor">@color/native_background</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="NativeCompactPrimaryButton" parent="@style/NativeCompactButton">
        <item name="android:background">@drawable/bg_native_button_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <style name="NativeDangerButton" parent="@style/NativeSecondaryButton">
        <item name="android:background">@drawable/bg_native_button_danger</item>
    </style>

    <style name="NativeCompactButton" parent="@style/NativeSecondaryButton">
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="NativeRailButton" parent="@style/NativeCompactButton">
        <item name="android:background">@drawable/bg_native_rail_button</item>
        <item name="android:textSize">12sp</item>
        <item name="android:minHeight">38dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="NativeSegmentOption" parent="@style/Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:background">@drawable/bg_native_segment_option</item>
        <item name="android:button">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/native_text_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="NativeSeekBar" parent="@style/Widget.AppCompat.SeekBar">
        <item name="android:thumbTint">@color/native_accent</item>
        <item name="android:progressTint">@color/native_accent</item>
        <item name="android:progressBackgroundTint">@color/native_track</item>
        <item name="android:splitTrack">false</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
