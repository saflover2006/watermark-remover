<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/native_background">

    <ScrollView
        android:id="@+id/rootScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="120dp">

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- HEADER CARD                                         -->
            <!-- ═══════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/native_surface"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingTop="16dp"
                android:paddingRight="16dp"
                android:paddingBottom="14dp">

                <!-- Title row: icon + app name + menu button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Gradient app icon badge -->
                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_splash_icon_gradient">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@mipmap/ic_launcher_round"
                            android:contentDescription="@null" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/nativeTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="@string/title_activity_native_preview"
                        android:textColor="@color/native_text_primary"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/pickImageButton"
                        style="@style/NativeCompactPrimaryButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:drawableStart="@android:drawable/ic_menu_gallery"
                        android:drawableTint="@color/native_text_primary"
                        android:drawablePadding="4dp"
                        android:text="@string/native_editor_open_media" />

                    <ImageButton
                        android:id="@+id/menuButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_native_button_secondary"
                        android:contentDescription="More options"
                        android:src="@android:drawable/ic_menu_more"
                        android:tint="@color/native_text_primary"
                        android:padding="8dp" />
                </LinearLayout>

                <!-- Subtitle row -->
                <TextView
                    android:id="@+id/nativeSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/native_editor_subtitle"
                    android:textColor="@color/native_text_muted"
                    android:textSize="13sp" />

                <!-- Status message with left accent border -->
                <TextView
                    android:id="@+id/nativeStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_native_status_accent"
                    android:paddingLeft="14dp"
                    android:paddingTop="10dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="10dp"
                    android:text="@string/native_editor_initial_status"
                    android:textColor="@color/native_text_secondary"
                    android:textSize="13sp" />

                <!-- Metadata chips row -->
                <HorizontalScrollView
                    android:id="@+id/editorSummaryGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:overScrollMode="never"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/imageMetaText"
                            style="@style/NativeSummaryChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:text="No media" />

                        <TextView
                            android:id="@+id/maskMetaText"
                            style="@style/NativeSummaryChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Mask 0" />

                        <TextView
                            android:id="@+id/modeMetaText"
                            style="@style/NativeSummaryChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Paint" />

                        <TextView
                            android:id="@+id/previewMetaText"
                            style="@style/NativeSummaryChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Edited" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Thin separator -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/native_border" />

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- CANVAS + CONTROLS BODY                              -->
            <!-- ═══════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="14dp"
                android:paddingTop="14dp"
                android:paddingRight="14dp">

                <!-- EDITOR CANVAS CARD -->
                <LinearLayout
                    android:id="@+id/editorWorkspaceCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_native_surface_card"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <!-- Canvas label row: zoom chip -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/nativeGestureHint"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Paint with one finger · Pinch to zoom"
                            android:textColor="@color/native_text_muted"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/zoomValueText"
                            style="@style/NativeValueChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100%"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Canvas -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="440dp"
                        android:background="@drawable/bg_native_editor_stage"
                        android:padding="1dp">

                        <com.watermarkremover.studio.nativepreview.NativeMaskEditorView
                            android:id="@+id/nativeEditorView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <TextView
                            android:id="@+id/nativeEmptyState"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_native_empty_state"
                            android:gravity="center"
                            android:maxWidth="240dp"
                            android:paddingLeft="16dp"
                            android:paddingTop="14dp"
                            android:paddingRight="16dp"
                            android:paddingBottom="14dp"
                            android:text="@string/native_editor_empty_state"
                            android:textColor="@color/native_text_secondary"
                            android:textSize="14sp"
                            android:lineSpacingMultiplier="1.3" />
                    </FrameLayout>

                    <!-- Preview section (compare mode) -->
                    <LinearLayout
                        android:id="@+id/previewSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/previewControlsGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <RadioGroup
                                android:id="@+id/previewModeGroup"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_native_segment_group"
                                android:orientation="horizontal"
                                android:padding="4dp">

                                <RadioButton
                                    android:id="@+id/previewEditedButton"
                                    style="@style/NativeSegmentOption"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="4dp"
                                    android:layout_weight="1"
                                    android:checked="true"
                                    android:text="Edited" />

                                <RadioButton
                                    android:id="@+id/previewOriginalButton"
                                    style="@style/NativeSegmentOption"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:layout_marginEnd="4dp"
                                    android:layout_weight="1"
                                    android:text="Original" />

                                <RadioButton
                                    android:id="@+id/previewCompareButton"
                                    style="@style/NativeSegmentOption"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:layout_weight="1"
                                    android:text="Split" />
                            </RadioGroup>

                            <!-- Compare slider -->
                            <LinearLayout
                                android:id="@+id/compareControls"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:background="@drawable/bg_native_meta_chip"
                                android:orientation="vertical"
                                android:padding="14dp"
                                android:visibility="gone">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/compareLabel"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="Before / after split"
                                        android:textColor="@color/native_text_primary"
                                        android:textSize="13sp" />

                                    <TextView
                                        android:id="@+id/compareValueText"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="50%"
                                        android:textColor="@color/native_accent"
                                        android:textSize="13sp"
                                        android:fontFamily="sans-serif-medium" />
                                </LinearLayout>

                                <SeekBar
                                    android:id="@+id/compareSeekBar"
                                    style="@style/NativeSeekBar"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:max="100"
                                    android:progress="50" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="Original"
                                        android:textColor="@color/native_text_muted"
                                        android:textSize="11sp" />

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:gravity="end"
                                        android:text="Edited"
                                        android:textColor="@color/native_text_muted"
                                        android:textSize="11sp" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Toolbar strip (horizontal scroll) -->
                    <HorizontalScrollView
                        android:id="@+id/editorCanvasActions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_native_segment_group"
                        android:padding="4dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/previewToggleButton"
                                style="@style/NativeRailButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawableStart="@android:drawable/ic_menu_view"
                                android:drawableTint="@color/native_text_primary"
                                android:drawablePadding="4dp"
                                android:text="@string/native_editor_show_preview" />

                            <Button
                                android:id="@+id/retouchToggleButton"
                                style="@style/NativeRailButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:drawableStart="@android:drawable/ic_menu_edit"
                                android:drawableTint="@color/native_text_primary"
                                android:drawablePadding="4dp"
                                android:text="@string/native_editor_hide_retouch" />

                            <Button
                                android:id="@+id/undoButton"
                                style="@style/NativeRailButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:drawableStart="@android:drawable/ic_menu_revert"
                                android:drawableTint="@color/native_text_primary"
                                android:drawablePadding="4dp"
                                android:enabled="false"
                                android:text="Undo" />

                            <Button
                                android:id="@+id/redoButton"
                                style="@style/NativeRailButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:drawableStart="@android:drawable/ic_media_ff"
                                android:drawableTint="@color/native_text_primary"
                                android:drawablePadding="4dp"
                                android:enabled="false"
                                android:text="Redo" />

                            <Button
                                android:id="@+id/fitViewButton"
                                style="@style/NativeRailButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:drawableStart="@android:drawable/ic_menu_zoom"
                                android:drawableTint="@color/native_text_primary"
                                android:drawablePadding="4dp"
                                android:enabled="false"
                                android:text="Fit" />
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- EMPTY STATE (shown when no image) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="@drawable/bg_native_surface_card"
                    android:layout_marginTop="0dp">

                    <!-- This is a visual-only empty state placeholder shown via GONE/VISIBLE by code -->
                    <!-- The real nativeEmptyState TextView lives inside the canvas above -->

                </LinearLayout>

                <!-- BRUSH CONTROLS CARD -->
                <LinearLayout
                    android:id="@+id/brushControlsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_native_surface_card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/retouchControlsGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Brush size -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/brushSizeLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Brush size: 36 px"
                                android:textColor="@color/native_text_primary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <SeekBar
                            android:id="@+id/brushSizeSeekBar"
                            style="@style/NativeSeekBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:max="112"
                            android:progress="28" />

                        <!-- Edge cleanup -->
                        <TextView
                            android:id="@+id/cleanupStrengthLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="Edge cleanup: 2 px"
                            android:textColor="@color/native_text_primary"
                            android:textSize="13sp" />

                        <SeekBar
                            android:id="@+id/cleanupStrengthSeekBar"
                            style="@style/NativeSeekBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:max="8"
                            android:progress="2" />

                        <!-- Paint / Erase mode toggle -->
                        <RadioGroup
                            android:id="@+id/maskModeGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/bg_native_segment_group"
                            android:orientation="horizontal"
                            android:padding="4dp">

                            <RadioButton
                                android:id="@+id/paintModeButton"
                                style="@style/NativeSegmentOption"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:checked="true"
                                android:text="✏ Paint" />

                            <RadioButton
                                android:id="@+id/eraseModeButton"
                                style="@style/NativeSegmentOption"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:layout_weight="1"
                                android:text="◻ Erase" />
                        </RadioGroup>
                    </LinearLayout>

                    <!-- Clear / Reset row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/clearMaskButton"
                            style="@style/NativeCompactButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:drawableStart="@android:drawable/ic_menu_close_clear_cancel"
                            android:drawableTint="@color/native_text_primary"
                            android:drawablePadding="4dp"
                            android:enabled="false"
                            android:text="Clear Mask" />

                        <Button
                            android:id="@+id/resetImageButton"
                            style="@style/NativeCompactButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:drawableStart="@android:drawable/ic_menu_revert"
                            android:drawableTint="@color/native_text_primary"
                            android:drawablePadding="4dp"
                            android:enabled="false"
                            android:text="Reset" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- FLOATING BOTTOM ACTION BAR                                  -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/bottomActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginLeft="14dp"
        android:layout_marginRight="14dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_native_surface_card"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/editActionBarGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Primary gradient action button -->
            <Button
                android:id="@+id/removeButton"
                style="@style/NativePrimaryButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="3"
                android:drawableStart="@android:drawable/ic_menu_edit"
                android:drawableTint="@color/native_text_primary"
                android:drawablePadding="6dp"
                android:enabled="false"
                android:text="Remove Watermark"
                android:textSize="14sp" />

            <!-- Secondary save button -->
            <Button
                android:id="@+id/saveImageButton"
                style="@style/NativeSecondaryButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_weight="2"
                android:drawableStart="@android:drawable/ic_menu_save"
                android:drawableTint="@color/native_text_primary"
                android:drawablePadding="6dp"
                android:enabled="false"
                android:text="Save PNG" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
