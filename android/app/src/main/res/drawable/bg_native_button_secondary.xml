<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/native_disabled_surface" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="@color/native_disabled_border" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/native_surface_raised" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="@color/native_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/native_surface_alt" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="@color/native_border" />
        </shape>
    </item>
</selector>
