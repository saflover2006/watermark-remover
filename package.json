{
  "name": "watermark-remover-web-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "start": "node server.mjs",
    "test": "node --test",
    "android:add": "npm run build:web && npx cap add android",
    "android:sync": "npm run build:web && npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npm run build:web && npx cap run android",
    "android:build:debug": "npm run android:sync && android\\gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/filesystem": "^6.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1"
  }
}
